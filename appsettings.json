{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=WebApiNetCoreDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Secret": "replace-with-a-secure-random-32-byte-minimum-secret-key",
    "Issuer": "WebApi.NetCore",
    "Audience": "WebApi.NetCore.Client",
    "ExpirationMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Database": {
    "AllowStartupWithoutInitialization": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7001"
    ]
  },
  "AppSettings": {
    "DefaultPageSize": 10,
    "MaxPageSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
